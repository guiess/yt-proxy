# Required — set these before first run
DOMAIN=yt.example.com
ACME_EMAIL=admin@example.com

# Auto-generated by scripts/setup.sh (or set manually)
HMAC_KEY=
POSTGRES_PASSWORD=
COMPANION_KEY=

# Optional — only for the search/video "HTTP 400" workaround (docker-compose.patch.yml).
# A current YouTube WEB InnerTube client version, exactly 16 chars (format 2.YYYYMMDD.rr.rr).
# Capture from a browser: F12 → Network → any youtubei/v1 request → X-Youtube-Client-Version.
# WEB_CLIENT_VERSION=2.20260721.01.00

# VPN settings (only needed with docker-compose.vpn.yml)
# VPN_PROVIDER=mullvad
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# FREE_ONLY=
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# VPN_COUNTRY=
